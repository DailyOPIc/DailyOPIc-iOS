// DailyOPIc Debug API server.
// For wireless iPhone testing through iPhone Hotspot, set this to the Mac IP from:
// ipconfig getifaddr en0
DAILYOPIC_DEBUG_SERVER_HOST = 172.20.10.2
DAILYOPIC_DEBUG_SERVER_PORT = 8000

// xcconfig treats // as a comment, so http:/$()/ expands to http://.
DAILYOPIC_API_BASE_URL = http:/$()/$(DAILYOPIC_DEBUG_SERVER_HOST):$(DAILYOPIC_DEBUG_SERVER_PORT)
