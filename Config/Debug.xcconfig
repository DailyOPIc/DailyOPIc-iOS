// DailyOPIc Debug API server.
// AdMob SSV callbacks must reach a public HTTPS URL. For local end-to-end
// rewarded-ad testing, point this at the active public HTTPS tunnel or dev server.
DAILYOPIC_DEBUG_SERVER_HOST = 172.20.10.2
DAILYOPIC_DEBUG_SERVER_PORT = 8000

// xcconfig treats // as a comment, so https:/$()/ expands to https://.
// Use http:/$()/ for local Mac/iPhone API testing.
DAILYOPIC_API_BASE_URL = https:/$()/dailyopic-api-992368032252.asia-northeast3.run.app

//http:/$()/172.20.10.2:8000 핫스팟 테스트

GAD_BANNER_AD_UNIT_ID = ca-app-pub-5460686409666356/5124626013
GAD_REWARDED_AD_UNIT_ID = ca-app-pub-5460686409666356/7091483531
GAD_TEST_DEVICE_IDS =210fa6282b33570fc7f95c3de26fc4d5

DAILYOPIC_PRIVACY_POLICY_URL = https:/$()/battle-princess-097.notion.site/2d05d51fd9518084a95ce3b9193eb5ed?source=copy_link

// 이용약관(EULA). 비워두면 Apple 표준 EULA로 폴백됨. 자체 약관이 있으면 여기에 URL 지정.
DAILYOPIC_TERMS_URL =

// RevenueCat public SDK key (App Store). 대시보드 > API Keys 에서 발급.
REVENUECAT_API_KEY = appl_PIFuXXinTfXfrLCVtTNFQMEArcd

// 개발자 로컬 오버라이드. 파일이 없으면 조용히 무시되므로 기본 동작은 위 값 그대로다.
// Config/Local.xcconfig.template 를 Config/Debug.local.xcconfig 로 복사해서 쓴다.
// 여기 아래에서 재정의한 값이 최종값이 된다 (xcconfig 는 나중 대입이 이긴다).
// Release 빌드는 이 include 를 갖지 않는다. 프로덕션 설정은 절대 오버라이드되지 않는다.
#include? "Debug.local.xcconfig"
// 앱 화면 = 이 주소의 웹앱(WKWebView). dev TestFlight는 archive 때 dev 주소로 덮어쓴다.
DAILYOPIC_WEB_URL = https:/$()/dev.dailyopic.link/study
